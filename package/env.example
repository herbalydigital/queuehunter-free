# QueueHunter customer configuration example. install.sh copies it to a private .env; edit that file.
# Keep .env private; never commit or share passwords, license keys, or session secrets.
APP_ENV=production
API_PORT=8000
PORT=5173
POLL_INTERVAL_SECONDS=2
CORS_ORIGINS=http://localhost:5173
QUEUEHUNTER_DB_PATH=./data/messages.db
LICENSE_KEY=
LICENSE_DATA_DIR=./data

# RabbitMQ capture. Set the source queue and a non-destructive capture topology.
RABBITMQ_URL=
RABBITMQ_SOURCE_QUEUE=
RABBITMQ_DECLARE_SOURCE_QUEUE=false
RABBITMQ_MIRROR_QUEUE=queuehunter-capture
RABBITMQ_CAPTURE_EXCHANGE=customer-existing-exchange
RABBITMQ_CAPTURE_EXCHANGE_TYPE=fanout
RABBITMQ_CAPTURE_ROUTING_KEY=
RABBITMQ_DLX=queuehunter.capture.dlx
RABBITMQ_DLQ=queuehunter-capture-dlq
RABBITMQ_PREFETCH_COUNT=10
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY_SECONDS=1

# Kafka capture.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=
# KAFKA_GROUP_ID is QueueHunter's own consumer group. Leave it empty to use
# queuehunter-<installation id>; never set it to one of your applications' groups.
KAFKA_GROUP_ID=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=

# Broker listeners can be independently disabled. Docker-specific values override the URLs above.
RABBITMQ_ENABLED=true
KAFKA_ENABLED=true
RABBITMQ_DOCKER_URL=
KAFKA_DOCKER_BOOTSTRAP_SERVERS=
